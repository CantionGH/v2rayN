<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
    <!-- Local-only: ad-hoc Avalonia/Skia libraries have no Apple Team ID. The
         whole installed bundle is root-owned and pinned by SHA-256. Do not add
         allow-jit, get-task-allow, or allow-dyld-environment-variables. -->
    <key>com.apple.security.cs.disable-library-validation</key><true/>
</dict></plist>
